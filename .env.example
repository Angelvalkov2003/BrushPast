NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shop (CIC) — products / gift boxes
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Charity / Foundation donations (Support Us) — separate Stripe account.
# Same two keys as any Stripe account (publishable + secret). Webhook is optional.
NEXT_PUBLIC_STRIPE_DONATIONS_PUBLISHABLE_KEY=
STRIPE_DONATIONS_SECRET_KEY=
# Optional — only if you add a webhook in that Stripe account
# STRIPE_DONATIONS_WEBHOOK_SECRET=

CLOUDINARY_URL=

RESEND_API_KEY=
CONTACT_EMAIL=

# Optional: full UK address list on checkout (Ideal Postcodes). Falls back to test key ak_test.
IDEAL_POSTCODES_API_KEY=

# Temporary: show "Pick up at event" (£0) on checkout. Set to false to hide after tests.
NEXT_PUBLIC_SHOW_EVENT_PICKUP=true

ADMIN_PASSWORD=